# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token
# ID чата администратора (уведомления о записях/отменах)
ADMIN_CHAT_ID=123456789

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=booking

# --- Подключения (для локального запуска без Docker; в compose собираются автоматически) ---
DATABASE_URL=postgresql+asyncpg://bot:change-me-strong-password@localhost:5432/booking
REDIS_URL=redis://localhost:6379/0

# --- Приложение ---
# Часовой пояс салона: рабочие часы и слоты считаются в нём
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
# Необязательные тонкие настройки (значения по умолчанию):
# WORK_START=10:00
# WORK_END=20:00
# SLOT_STEP_MINUTES=30
# REMINDER_OFFSET_MINUTES=120
